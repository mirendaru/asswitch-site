---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE, DEFAULT_AUTHOR } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Essays — ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<!-- Always-visible way home, pinned to the top center -->
		<a class="home-top" href="/">Asswitch Studio</a>

		<main class="essays">
			<header class="masthead">
				<h1>Essays</h1>
			</header>

			<ul class="list">
				{
					posts.map((post) => (
						<li class="entry">
							<a class="entry-link" href={`/blog/${post.id}/`}>
								<span class="title">{post.data.title}</span>
								<span class="meta">
									<span class="author">{post.data.author ?? DEFAULT_AUTHOR}</span>
									<span class="dot">·</span>
									<FormattedDate date={post.data.pubDate} />
								</span>
							</a>
						</li>
					))
				}
			</ul>
		</main>

		<style>
			.essays {
				max-width: 40rem;
				margin: 0 auto;
			}

			.home-top {
				position: sticky;
				top: 0;
				z-index: 10;
				display: block;
				text-align: center;
				padding: 1.3rem 0;
				background: #fff;
				font-size: 0.85rem;
				letter-spacing: 0.02em;
				color: #888;
				text-decoration: none;
			}
			.home-top:hover {
				color: #111;
			}

			.masthead {
				margin-bottom: 3.5rem;
			}

			.back {
				display: inline-block;
				font-size: 0.85rem;
				letter-spacing: 0.02em;
				color: #888;
				text-decoration: none;
				margin-bottom: 1.5rem;
			}
			.back:hover {
				color: #111;
			}

			.masthead h1 {
				font-family: 'Libre Caslon Display', Georgia, serif;
				font-size: 2rem;
				font-weight: 400;
				margin: 0;
			}

			.list {
				list-style: none;
				padding: 0;
				margin: 0;
			}

			.entry-link {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				gap: 1.5rem;
				padding: 0.5rem 0;
				text-decoration: none;
				color: inherit;
			}

			.title {
				font-size: 0.95rem;
				line-height: 1.4;
			}
			.entry-link:hover .title {
				text-decoration: underline;
				text-underline-offset: 3px;
			}

			.meta {
				flex: none;
				font-size: 0.72rem;
				color: #999;
				white-space: nowrap;
			}
			.dot {
				margin: 0 0.35rem;
			}

			@media (max-width: 768px) {
				.masthead h1 {
					font-size: 1.6rem;
				}
				.title {
					font-size: 0.9rem;
				}
			}
		</style>
	</body>
</html>
