---
import BaseHead from '../components/BaseHead.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About — ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<a class="home-top" href="/">asswitch</a>

		<main class="about">
			<p>
				Asswitch Studio, since 2016. PGE started it; Hynes Chan didn’t stop him.
			</p>
			<p>
				We make things across every medium we can reach, on the theory that at least one of them will be good.
			</p>
		</main>

		<style>
			.about {
				width: fit-content;
				margin: 32vh auto 0 auto;
				font-size: 1.05rem;
				line-height: 1.7;
			}
			.about p {
				margin: 0 0 1.2rem 0;
				white-space: nowrap;
			}

			.home-top {
				position: sticky;
				top: 0;
				z-index: 10;
				display: block;
				text-align: center;
				padding: 1.3rem 0;
				background: #fff;
				font-family: 'SF Pro', -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
				font-size: 0.85rem;
				font-weight: 600;
				font-stretch: expanded;
				font-variation-settings: 'wdth' 125;
				letter-spacing: 0.02em;
				color: #7b2f2c;
				text-decoration: none;
			}
			.home-top:hover {
				color: #111;
			}

			@media (max-width: 999px) {
				.about {
					margin: 20vh auto 0;
					padding: 0 1.2rem;
					width: auto;
					max-width: 100%;
					font-size: 1rem;
				}
				.about p {
					white-space: normal;
				}
			}
		</style>
	</body>
</html>
