---
import BaseHead from '../components/BaseHead.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About — ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<a class="home-top" href="/">Asswitch Studio</a>

		<main class="about">
			<p>
				Asswitch Studio was founded in 2016 by PGE with the help of Hynes Chan.
			</p>
			<p>
				We are trying out everything because that’s just what life is about.
			</p>
		</main>

		<style>
			.about {
				width: fit-content;
				margin: 32vh auto 0 auto;
				font-size: 1.05rem;
				line-height: 1.7;
			}
			.about p {
				margin: 0 0 1.2rem 0;
				white-space: nowrap;
			}

			.home-top {
				position: sticky;
				top: 0;
				z-index: 10;
				display: block;
				text-align: center;
				padding: 1.3rem 0;
				background: #fff;
				font-size: 0.85rem;
				letter-spacing: 0.02em;
				color: #888;
				text-decoration: none;
			}
			.home-top:hover {
				color: #111;
			}

			@media (max-width: 999px) {
				.about {
					margin: 20vh auto 0;
					padding: 0 1.2rem;
					width: auto;
					max-width: 100%;
					font-size: 1rem;
				}
				.about p {
					white-space: normal;
				}
			}
		</style>
	</body>
</html>
