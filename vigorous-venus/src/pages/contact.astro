---
import BaseHead from '../components/BaseHead.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Contact — ${SITE_TITLE}`} description="One address. Write to it." />
	</head>
	<body>
		<a class="home-top" href="/">asswitch</a>

		<main class="contact">
			<p class="line">If you want to have a word with me, you might get one back.</p>
			<p class="address">
				<a href="mailto:pp@asswitch.studio">pp@asswitch.studio</a>
			</p>
		</main>

		<style>
			.contact {
				width: fit-content;
				margin: 32vh auto 0 auto;
				font-size: 1.05rem;
				line-height: 1.7;
			}

			.line {
				margin: 0;
				white-space: nowrap;
			}

			.address {
				margin: 2.2rem 0 0;
			}
			.address a {
				color: inherit;
				text-decoration: none;
				border-bottom: 1px solid #ddd;
				padding-bottom: 1px;
				transition: border-color 0.25s ease, color 0.25s ease;
			}
			.address a:hover {
				color: #7b2f2c;
				border-bottom-color: #7b2f2c;
			}

			.home-top {
				position: sticky;
				top: 0;
				z-index: 10;
				display: block;
				text-align: center;
				padding: 1.3rem 0;
				background: #fff;
				font-family: 'SF Pro', -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
				font-size: 0.85rem;
				font-weight: 600;
				font-stretch: expanded;
				font-variation-settings: 'wdth' 125;
				letter-spacing: 0.02em;
				color: #7b2f2c;
				text-decoration: none;
			}
			.home-top:hover {
				color: #111;
			}

			@media (max-width: 999px) {
				.contact {
					margin: 20vh auto 0;
					padding: 0 1.2rem;
					width: auto;
					max-width: 100%;
					font-size: 1rem;
				}
				.line {
					white-space: normal;
				}
			}
		</style>
	</body>
</html>
