---
import { SITE_TITLE } from '../consts';
import photos from '../data/rusticitas-photos.json';

// Shuffled once at build time so the wall reads as randomly laid out.
function shuffle<T>(arr: T[]): T[] {
	const a = [...arr];
	for (let i = a.length - 1; i > 0; i--) {
		const j = Math.floor(Math.random() * (i + 1));
		[a[i], a[j]] = [a[j], a[i]];
	}
	return a;
}
const shuffled = shuffle(photos);

// Deterministic small tilt per photo (based on its filename) for a loose,
// unaligned feel without any client-side layout math.
function hash(s: string) {
	let h = 0;
	for (let i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) | 0;
	return h;
}
const rotations = shuffled.map((p) => ((Math.abs(hash(p.src)) % 7) - 3));
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>RUSTICITAS ANIMI ET NUDA ORATIO — {SITE_TITLE}</title>
		<meta name="description" content="Photographs, in the spirit of lo-fi. All shot on iPhone 7 Plus." />
	</head>
	<body>
		<a class="home-top" href="/">Asswitch Studio</a>

		<main class="wall">
			<div class="masonry">
				{
					shuffled.map((p, i) => (
						<figure class="tile" style={`--rot:${rotations[i]}deg`}>
							<img
								src={p.src}
								width={p.width}
								height={p.height}
								loading="lazy"
								decoding="async"
								alt=""
							/>
						</figure>
					))
				}
			</div>

			<p class="colophon">
				in spirit of lo-fi<br />
				all shot on iPhone 7 Plus
			</p>
		</main>

		<style is:global>
			html,
			body {
				margin: 0;
				padding: 0;
				background: #000;
			}
		</style>

		<style>
			.home-top {
				position: sticky;
				top: 0;
				z-index: 10;
				display: block;
				text-align: center;
				padding: 1.3rem 0;
				background: rgba(0, 0, 0, 0.92);
				font-family: Helvetica, Arial, sans-serif;
				font-size: 0.85rem;
				letter-spacing: 0.02em;
				color: #999;
				text-decoration: none;
			}
			.home-top:hover {
				color: #fff;
			}

			.wall {
				padding: 2rem 1.5rem 4rem;
			}

			.masonry {
				column-count: 4;
				column-gap: 1.1rem;
			}

			.tile {
				margin: 0 0 1.1rem;
				break-inside: avoid;
				transform: rotate(var(--rot));
			}

			.tile img {
				display: block;
				width: 100%;
				height: auto;
			}

			.colophon {
				margin: 3rem 0 0;
				text-align: center;
				font-family: Helvetica, Arial, sans-serif;
				font-size: 0.78rem;
				line-height: 1.9;
				letter-spacing: 0.03em;
				color: rgba(255, 255, 255, 0.55);
			}

			@media (max-width: 1100px) {
				.masonry {
					column-count: 3;
				}
			}

			@media (max-width: 720px) {
				.masonry {
					column-count: 2;
					column-gap: 0.7rem;
				}
				.tile {
					margin-bottom: 0.7rem;
				}
			}

			@media (max-width: 460px) {
				.masonry {
					column-count: 1;
				}
			}
		</style>
	</body>
</html>
