---
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

// Each scattered word. `top`/`left` are percentages of the viewport.
// Swap `href` to real pages as they get built; '#' = placeholder for now.
const words = [
	{ label: 'Founder', href: '/founder', top: 23, left: 20 },
	{ label: 'publication', href: '#', top: 31, left: 8 },
	{ label: 'murmurs', href: '#', top: 36, left: 35 },
	{ label: 'Another writing app？', href: '/another-writing-app', top: 44, left: 50 },
	{ label: 'PAHF！', href: '#', top: 26, left: 58 },
	{ label: 'No More School', href: '#', top: 28, left: 80 },
	{ label: 'Reviews', href: '/reviews', top: 43, left: 12 },
	{ label: 'Essays', href: '/blog', top: 47, left: 27 },
	{ label: 'Apps', href: '#', top: 41, left: 68 },
	{ label: 'the empty chairs', href: '#', top: 54, left: 46 },
	{ label: 'chronicles', href: '#', top: 50, left: 83 },
	{ label: 'Designing Summer', href: '#', top: 59, left: 64 },
	{ label: 'Gogotein Gallery', href: '#', top: 65, left: 88 },
	{ label: 'research', href: '#', top: 62, left: 36 },
	{ label: 'Personal History', href: '/personal-history', top: 57, left: 22 },
	{ label: 'home improvement', href: '#', top: 67, left: 15 },
	{ label: 'THE ANTI SOCIAL MEDIA ASSOCIATION', href: '/asma', top: 71, left: 54 },
	{ label: 'RUSTICITAS ANIMI ET NUDA ORATIO', href: '/rusticitas', top: 74, left: 74 },
	{ label: 'MyMoodyMac', href: '#', top: 77, left: 6 },
	{ label: 'papercunt', href: '#', top: 81, left: 25 },
	{ label: 'contact', href: '#', top: 83, left: 64 },
	{ label: 'about', href: '/about', top: 87, left: 40 },
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{SITE_TITLE}</title>
		<meta name="description" content={SITE_DESCRIPTION} />

		<!-- The scattered links are set in the same serif as the writing. -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Libre+Caslon+Text&display=swap"
		/>
	</head>
	<body>
		<main class="stage" style="background-image: url('/images/home-background.jpg')">
			<h1 class="wordmark">asswitch</h1>

			<nav class="scatter" aria-label="Site">
				{
					words.map((w) => (
						<a
							class:list={['word', w.href === '#' ? 'inactive' : 'active']}
							href={w.href}
							style={`top:${w.top}%; left:${w.left}%`}
							data-top={w.top}
							data-left={w.left}
						>
							{w.label}
						</a>
					))
				}
			</nav>

			<!-- Plain stacked fallback for small screens -->
			<nav class="stacked" aria-label="Site (compact)">
				{
					words.map((w) => (
						<a class:list={[w.href === '#' ? 'inactive' : 'active']} href={w.href}>
							{w.label}
						</a>
					))
				}
			</nav>

			<p class="construction wide-only">some pages are under construction</p>
			<p class="construction narrow-only">best viewed on a desktop browser</p>

			<!-- Visitor controls: recolour the links, or put them back where
			     they started after dragging them around. -->
			<div class="picker">
				<div class="palette" id="palette" hidden>
					<div class="wheel" id="wheel">
						<span class="knob" id="knob"></span>
					</div>
				</div>
				<button
					class="swatch"
					type="button"
					id="swatch"
					aria-label="pick a link colour"
					aria-expanded="false"
				/>
			</div>
			<button class="reset" type="button" id="reset-positions">reset</button>
		</main>

		<style is:global>
			html,
			body {
				margin: 0;
				padding: 0;
				background: #000;
			}
		</style>

		<style>
			.stage {
				position: relative;
				width: 100%;
				min-height: 100vh;
				background-size: cover;
				background-position: center;
				overflow: hidden;
				font-family: Helvetica, Arial, sans-serif;
				color: #fff;
			}

			.wordmark {
				position: absolute;
				/* Sits on the window's crossbar. JS refines this per viewport —
				   see anchorWordmark(); this value is the pre-script default. */
				top: 8.8%;
				left: 50%;
				transform: translateX(-50%);
				margin: 0;
				white-space: nowrap;
				font-family: 'SF Pro', -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
				font-size: clamp(1.05rem, 1.6vw, 2rem);
				font-weight: 600;
				font-stretch: expanded;
				font-variation-settings: 'wdth' 125;
				letter-spacing: 0.01em;
				filter: blur(0.5px);
				pointer-events: none;
			}

			.scatter {
				position: absolute;
				inset: 0;
			}

			.construction {
				position: fixed;
				bottom: 0.9rem;
				left: 50%;
				transform: translateX(-50%);
				margin: 0;
				font-size: 0.62rem;
				letter-spacing: 0.03em;
				color: rgba(255, 255, 255, 0.42);
				filter: blur(0.4px);
				pointer-events: none;
			}
			.narrow-only {
				display: none;
			}

			/* Both controls stay smaller than the link text. */
			.picker,
			.reset {
				position: fixed;
				bottom: 0.9rem;
				z-index: 5;
				font-size: clamp(0.62rem, 0.82vw, 0.82rem);
			}

			.picker {
				left: 1.1rem;
				line-height: 0;
			}

			.swatch {
				display: block;
				width: 0.95em;
				height: 0.95em;
				padding: 0;
				border: 1px solid rgba(255, 255, 255, 0.55);
				border-radius: 50%;
				background: var(--link-colour, #fff);
				cursor: pointer;
				transition: transform 0.25s ease;
			}
			.swatch:hover {
				transform: scale(1.15);
			}

			/* Rounded slab of frosted glass floating above the swatch. */
			.palette {
				position: absolute;
				bottom: calc(100% + 0.55rem);
				left: -0.35rem;
				display: flex;
				align-items: center;
				justify-content: center;
				width: 132px;
				height: 122px;
				border: 1px solid rgba(255, 255, 255, 0.22);
				border-radius: 18px;
				background: rgba(255, 255, 255, 0.1);
				backdrop-filter: blur(18px) saturate(1.5);
				-webkit-backdrop-filter: blur(18px) saturate(1.5);
				box-shadow: 0 8px 26px rgba(0, 0, 0, 0.3);
				animation: palette-in 0.24s ease;
			}
			.palette[hidden] {
				display: none;
			}

			@keyframes palette-in {
				from {
					opacity: 0;
					transform: translateY(5px) scale(0.94);
				}
				to {
					opacity: 1;
					transform: none;
				}
			}

			/* Hue around the rim, washing out to white at the centre. */
			.wheel {
				position: relative;
				width: 94px;
				height: 94px;
				border-radius: 50%;
				cursor: crosshair;
				touch-action: none;
				background:
					radial-gradient(circle closest-side, #fff 0%, rgba(255, 255, 255, 0) 70%),
					conic-gradient(
						hsl(0, 100%, 50%),
						hsl(60, 100%, 50%),
						hsl(120, 100%, 50%),
						hsl(180, 100%, 50%),
						hsl(240, 100%, 50%),
						hsl(300, 100%, 50%),
						hsl(360, 100%, 50%)
					);
				box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.25);
			}

			.knob {
				position: absolute;
				top: 50%;
				left: 50%;
				width: 9px;
				height: 9px;
				border: 2px solid #fff;
				border-radius: 50%;
				box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.35);
				transform: translate(-50%, -50%);
				pointer-events: none;
			}

			.reset {
				right: 1.1rem;
				padding: 0;
				border: none;
				background: none;
				font-family: inherit;
				letter-spacing: 0.03em;
				color: rgba(255, 255, 255, 0.42);
				cursor: pointer;
				transition: color 0.25s ease;
			}
			.reset:hover {
				color: rgba(255, 255, 255, 0.85);
			}

			.word {
				position: absolute;
				transform: translate(-50%, -50%);
				color: #fff;
				text-decoration: none;
				font-family: 'Libre Caslon Text', Georgia, serif;
				/* nudged up a touch — the serif reads smaller than the sans did */
				font-size: clamp(0.85rem, 1.12vw, 1.15rem);
				white-space: nowrap;
				cursor: grab;
				user-select: none;
				-webkit-user-select: none;
				touch-action: none;
				transition: color 0.25s ease;
			}

			/* Words with a real page: visitor-settable colour, green on hover */
			.word.active {
				color: var(--link-colour, #fff);
			}
			.word.active:hover,
			.word.active:focus-visible {
				color: #b9e580;
				outline: none;
			}
			.word.active.dragging {
				color: #b9e580;
			}

			/* Words still under construction: muted grey */
			.word.inactive {
				color: #8f8f8f;
			}

			.word.dragging {
				cursor: all-scroll;
			}

			.stacked {
				display: none;
			}

			/* On small screens: hide the scatter, show a clean stacked list */
			@media (max-width: 768px) {
				.stage {
					min-height: 100vh;
					padding: 2rem 1.25rem 3rem;
					box-sizing: border-box;
				}
				.wordmark {
					position: static;
					transform: none;
					white-space: normal;
					font-size: 1.25rem;
					margin-bottom: 2rem;
					text-align: center;
				}
				.scatter {
					display: none;
				}
				/* No dragging or recolouring on the stacked layout. */
				.picker,
				.reset {
					display: none;
				}
				/* One centred column, sized down so the longer titles fit. */
				.stacked {
					display: flex;
					flex-direction: column;
					align-items: center;
					text-align: center;
					gap: 0.7rem;
				}
				.stacked a {
					text-decoration: none;
					font-family: 'Libre Caslon Text', Georgia, serif;
					font-size: 0.9rem;
					line-height: 1.35;
				}
				/* same signal as the desktop scatter: grey means nothing to open yet */
				.stacked a.active {
					color: var(--link-colour, #fff);
				}
				.stacked a.inactive {
					color: #8f8f8f;
				}
				.stacked a.active:active {
					color: #b9e580;
				}

				.wide-only {
					display: none;
				}
				.narrow-only {
					display: block;
				}
			}
		</style>

		<script>
			// Scattered words: press-and-hold to drag (never over the wordmark),
			// a plain click (no drag) navigates. Dragged positions persist
			// across visits via localStorage.
			const STORAGE_KEY = 'asswitch:scatter-positions';
			const DRAG_THRESHOLD = 4; // px of movement before a press counts as a drag

			function loadPositions(): Record<string, { top: number; left: number }> {
				try {
					return JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}');
				} catch {
					return {};
				}
			}

			function savePosition(label: string, topPct: number, leftPct: number) {
				const all = loadPositions();
				all[label] = { top: topPct, left: leftPct };
				try {
					localStorage.setItem(STORAGE_KEY, JSON.stringify(all));
				} catch {}
			}

			function initScatter() {
				const scatter = document.querySelector<HTMLElement>('.scatter');
				const wordmark = document.querySelector<HTMLElement>('.wordmark');
				if (!scatter) return;
				const words = scatter.querySelectorAll<HTMLAnchorElement>('.word');

				const overlaps = (a: DOMRect, b: DOMRect, pad = 6) =>
					!(
						a.right < b.left + pad ||
						a.left > b.right - pad ||
						a.bottom < b.top + pad ||
						a.top > b.bottom - pad
					);

				const saved = loadPositions();

				words.forEach((el) => {
					const label = el.textContent?.trim() ?? '';
					const pos = saved[label];
					if (pos) {
						el.style.top = pos.top + '%';
						el.style.left = pos.left + '%';
					}

					let active = false;
					let dragged = false;
					let startX = 0;
					let startY = 0;
					let baseLeft = 0;
					let baseTop = 0;
					let goodLeft = 0;
					let goodTop = 0;

					el.addEventListener('pointerdown', (e) => {
						e.preventDefault();
						const scRect = scatter.getBoundingClientRect();
						const elRect = el.getBoundingClientRect();
						// Switch from percent + translate centering to absolute top-left px
						baseLeft = elRect.left - scRect.left;
						baseTop = elRect.top - scRect.top;
						el.style.left = baseLeft + 'px';
						el.style.top = baseTop + 'px';
						el.style.transform = 'none';
						goodLeft = baseLeft;
						goodTop = baseTop;
						startX = e.clientX;
						startY = e.clientY;
						active = true;
						dragged = false;
						el.classList.add('dragging');
						el.setPointerCapture(e.pointerId);
					});

					el.addEventListener('pointermove', (e) => {
						if (!active) return;
						if (
							Math.abs(e.clientX - startX) > DRAG_THRESHOLD ||
							Math.abs(e.clientY - startY) > DRAG_THRESHOLD
						) {
							dragged = true;
						}
						const scRect = scatter.getBoundingClientRect();
						const w = el.offsetWidth;
						const h = el.offsetHeight;
						let nl = baseLeft + (e.clientX - startX);
						let nt = baseTop + (e.clientY - startY);
						// Keep inside the stage
						nl = Math.max(0, Math.min(nl, scRect.width - w));
						nt = Math.max(0, Math.min(nt, scRect.height - h));
						// Reject any position that would overlap the wordmark
						if (wordmark) {
							const cand = new DOMRect(scRect.left + nl, scRect.top + nt, w, h);
							if (overlaps(cand, wordmark.getBoundingClientRect())) {
								el.style.left = goodLeft + 'px';
								el.style.top = goodTop + 'px';
								return;
							}
						}
						goodLeft = nl;
						goodTop = nt;
						el.style.left = nl + 'px';
						el.style.top = nt + 'px';
					});

					const end = (e: PointerEvent) => {
						if (!active) return;
						active = false;
						el.classList.remove('dragging');
						try {
							el.releasePointerCapture(e.pointerId);
						} catch {}
						if (dragged) {
							const scRect = scatter.getBoundingClientRect();
							const centerLeftPct = ((goodLeft + el.offsetWidth / 2) / scRect.width) * 100;
							const centerTopPct = ((goodTop + el.offsetHeight / 2) / scRect.height) * 100;
							savePosition(label, centerTopPct, centerLeftPct);
						}
					};
					el.addEventListener('pointerup', end);
					el.addEventListener('pointercancel', end);

					// A plain click (no drag in between) navigates.
					el.addEventListener('click', (e) => {
						e.preventDefault();
						if (dragged) {
							dragged = false;
							return;
						}
						const href = el.getAttribute('href');
						if (href && href !== '#') window.location.href = href;
					});
				});
			}

			initScatter();

			// Put every word back where it was authored, and forget the saved
			// layout so a reload doesn't bring the dragged one back.
			function initReset() {
				const button = document.getElementById('reset-positions');
				const words = document.querySelectorAll<HTMLAnchorElement>('.scatter .word');
				if (!button) return;
				button.addEventListener('click', () => {
					try {
						localStorage.removeItem(STORAGE_KEY);
					} catch {}
					words.forEach((el) => {
						el.style.top = (el.dataset.top ?? '') + '%';
						el.style.left = (el.dataset.left ?? '') + '%';
						// Dragging swaps in `transform: none`; clear it so the
						// stylesheet's centring transform applies again.
						el.style.transform = '';
					});
				});
			}

			// Let visitors recolour the links, and remember their choice.
			const COLOUR_KEY = 'asswitch:link-colour';

			function initColourPicker() {
				const swatch = document.getElementById('swatch');
				const palette = document.getElementById('palette');
				if (!swatch || !palette) return;

				const apply = (colour: string) => {
					document.documentElement.style.setProperty('--link-colour', colour);
					try {
						localStorage.setItem(COLOUR_KEY, colour);
					} catch {}
				};

				try {
					const saved = localStorage.getItem(COLOUR_KEY);
					if (saved) document.documentElement.style.setProperty('--link-colour', saved);
				} catch {}

				const close = () => {
					palette.hidden = true;
					swatch.setAttribute('aria-expanded', 'false');
				};

				swatch.addEventListener('click', (e) => {
					e.stopPropagation();
					const open = palette.hidden;
					palette.hidden = !open;
					swatch.setAttribute('aria-expanded', String(open));
				});

				const wheel = document.getElementById('wheel');
				const knob = document.getElementById('knob');

				// Full-brightness HSV, so the rim is pure hue and the middle is white.
				const toHex = (h: number, s: number) => {
					const c = s;
					const x = c * (1 - Math.abs(((h / 60) % 2) - 1));
					const m = 1 - c;
					const [r, g, b] =
						h < 60
							? [c, x, 0]
							: h < 120
								? [x, c, 0]
								: h < 180
									? [0, c, x]
									: h < 240
										? [0, x, c]
										: h < 300
											? [x, 0, c]
											: [c, 0, x];
					const hex = (n: number) =>
						Math.round((n + m) * 255)
							.toString(16)
							.padStart(2, '0');
					return `#${hex(r)}${hex(g)}${hex(b)}`;
				};

				if (wheel && knob) {
					const pick = (e: PointerEvent) => {
						const r = wheel.getBoundingClientRect();
						const radius = r.width / 2;
						const dx = e.clientX - (r.left + radius);
						const dy = e.clientY - (r.top + radius);
						const dist = Math.hypot(dx, dy);
						// hue runs clockwise from 12 o'clock, matching the gradient
						const hue = (((Math.atan2(dx, -dy) * 180) / Math.PI) + 360) % 360;
						// the white wash fades out by 70% of the radius
						const sat = Math.min(1, dist / (radius * 0.7));
						const capped = Math.min(dist, radius);
						knob.style.left = `${radius + (dx / (dist || 1)) * capped}px`;
						knob.style.top = `${radius + (dy / (dist || 1)) * capped}px`;
						apply(toHex(hue, sat));
					};

					let dragging = false;

					wheel.addEventListener('pointerdown', (e) => {
						e.stopPropagation();
						dragging = true;
						// Capture keeps the drag alive outside the wheel, but a
						// failure here must not cost us the pick itself.
						try {
							wheel.setPointerCapture(e.pointerId);
						} catch {}
						pick(e);
					});
					wheel.addEventListener('pointermove', (e) => {
						if (dragging) pick(e);
					});
					const stop = () => {
						dragging = false;
					};
					wheel.addEventListener('pointerup', stop);
					wheel.addEventListener('pointercancel', stop);
				}

				palette.addEventListener('click', (e) => e.stopPropagation());

				document.addEventListener('click', close);
				document.addEventListener('keydown', (e) => {
					if (e.key === 'Escape') close();
				});
			}

			initReset();
			initColourPicker();

			// The background is painted with `cover`, so the window's crossbar
			// lands at a different viewport y depending on the viewport's aspect
			// ratio. Recompute the wordmark's top so it keeps sitting on the bar.
			const BG_W = 2400;
			const BG_H = 1315;
			const CROSSBAR_Y = 134; // centre of the bar, in background-image pixels

			function anchorWordmark() {
				const stage = document.querySelector<HTMLElement>('.stage');
				const mark = document.querySelector<HTMLElement>('.wordmark');
				if (!stage || !mark) return;
				// The mobile layout puts the wordmark in normal flow; leave it alone.
				if (window.innerWidth <= 768) {
					mark.style.top = '';
					return;
				}
				const { width, height } = stage.getBoundingClientRect();
				const scale = Math.max(width / BG_W, height / BG_H);
				const offsetY = (height - BG_H * scale) / 2;
				const barY = offsetY + CROSSBAR_Y * scale;
				// On very wide viewports the bar is cropped off the top, so clamp
				// the wordmark into view rather than letting it follow off-screen.
				const top = barY - mark.offsetHeight / 2;
				const minTop = height * 0.04;
				mark.style.top = Math.round(Math.max(top, minTop)) + 'px';
			}

			anchorWordmark();
			window.addEventListener('resize', anchorWordmark);
		</script>
	</body>
</html>
